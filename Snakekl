.wn b{display:block;font-size:24px}.wn span{font-size:13px;color:#d6cdfa}
.tabs{display:flex;gap:6px}.tabs button{flex:1;padding:9px;border-radius:999px;background:rgba(255,255,255,.08);font-weight:700}
.tabs .on{background:#a56bff;color:#fff}
.list{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.card{display:flex;flex-direction:column;gap:4px;padding:12px;border-radius:14px;background:rgba(255,255,255,.08);text-align:left;border:1px solid rgba(255,255,255,.1)}
.card span{font-size:13px;color:#bdb2f0}.card.eq{border-color:#ffc61a}
.dots{display:flex;gap:4px}.dots i{width:12px;height:12px;border-radius:50%}
.row{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:14px;background:rgba(255,255,255,.08)}
.row>div{flex:1;min-width:0}.row small{display:block;color:#bdb2f0}
.bar2{height:5px;border-radius:3px;background:rgba(255,255,255,.12);margin-top:6px;overflow:hidden}.bar2 u{display:block;height:100%;background:#a56bff}
.tg{display:flex;justify-content:space-between;align-items:center;padding:13px 14px;border-radius:14px;background:rgba(255,255,255,.08);font-weight:700;text-align:left}
