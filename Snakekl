@keyframes in{from{opacity:0;transform:translateY(14px)}}
.box h1{margin:0;font-size:clamp(40px,13vw,56px);font-weight:800;letter-spacing:-.03em;line-height:1;text-align:center;text-shadow:0 0 24px #a56bff}
