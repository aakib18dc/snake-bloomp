  else if(panel==='coll'){
    const L=[SK,TR,EY][tab],k='ste'[tab];
    h='<h2>Collection</h2><div class="tabs">'+['Skins','Trails','Eyes'].map((n,i)=>'<button type="button" class="'+(i===tab?'on':'')+'" data-a="tab'+i+'">'+n+'</button>').join('')+'</div><div class="list">'+L.map((it,i)=>{const own=sv.unl[k].includes(i),eq=sv.sel[k]===i;return '<button type="button" class="card'+(eq?' eq':'')+'" data-a="it'+i+'"><b>'+it.n+'</b>'+(tab===0?'<span class="dots">'+(it.p||PAL).map(c=>'<i style="background:'+c+'"></i>').join('')+'</span>':'')+'<span>'+(eq?'Equipped':own?'Tap to equip':it.c+' petals')+'</span></button>'}).join('')+'</div><p class="sub"><span>'+sv.pet+' petals</span></p>'+back;
  }
  else if(panel==='ach')h='<h2>Achievements</h2>'+ACH.map(a=>'<div class="row"><div><b>'+a[1]+'</b><small>'+a[2]+'</small></div><span>'+(sv.ach[a[0]]?'✓':'+'+a[3])+'</span></div>').join('')+back;
  else if(panel==='dly'){
    const e=new Date(),m=Math.ceil((new Date(e.getFullYear(),e.getMonth(),e.getDate()+1)-e)/60000);
    h='<h2>Daily challenges</h2>'+daily().map((c,i)=>{const D=DD[c.i];return '<div class="row"><div><b>'+D[1]+' '+c.n+'</b><small>'+Math.min(c.p,c.n)+' / '+c.n+'</small><div class="bar2"><u style="width:'+Math.min(100,c.p/c.n*100)+'%"></u></div></div>'+(c.c?'<span>✓</span>':'<button type="button" class="b" data-a="claim'+i+'"'+(c.p>=c.n?'':' disabled')+'>+50</button>')+'</div>'}).join('')+'<p class="sub"><span>New challenges in '+(m/60|0)+'h '+m%60+'m</span></p>'+back;
  }
  else if(panel==='stats'){
    const rows=[['Best score',mm('score')],['Longest snake',mm('len')||3],['Top combo','×'+mm('combo')],['Orbs eaten',tt('orbs')],['Longest run',fmt(mm('secs'))],['Time played',fmt(tt('secs'))],['Missions',tt('mis')],['Bosses beaten',tt('boss')],['Power-ups',tt('pow')],['Largest arena',mm('arena')||11],['Walls crossed',tt('wrap')],['Close calls',tt('close')]];
    h='<h2>Statistics</h2><div class="list">'+rows.map(r=>'<div class="card"><b>'+r[1]+'</b><span>'+r[0]+'</span></div>').join('')+'</div>'+back;
  }
  else h='<h2>Settings</h2>'+[['snd','Sound effects'],['mus','Music pulse'],['vib','Vibration'],['gho','Ghost replay']].map(r=>'<button type="button" class="tg" role="switch" aria-checked="'+!!sv.set[r[0]]+'" data-a="s-'+r[0]+'">'+r[1]+'<i></i></button>').join('')+'<button type="button" class="b" data-a="reset">'+(rs?'Tap again to erase everything':'Reset progress')+'</button>'+back;
  b.innerHTML=h;
}

let sx=null,sy=0,pid=-1;
stage.addEventListener('pointerdown',e=>{if(state!=='play'||pid>=0)return;pid=e.pointerId;sx=e.clientX;sy=e.clientY;try{stage.setPointerCapture(pid)}catch(_){}});
stage.addEventListener('pointermove',e=>{
  if(e.pointerId!==pid||state!=='play')return;
  const dx=e.clientX-sx,dy=e.clientY-sy;
  if(Math.max(Math.abs(dx),Math.abs(dy))<24)return;
  Math.abs(dx)>Math.abs(dy)?turn(dx>0?1:-1,0):turn(0,dy>0?1:-1);
  sx=e.clientX;sy=e.clientY;
});
const up=e=>{if(e.pointerId===pid){pid=-1;sx=null}};
['pointerup','pointercancel','lostpointercapture'].forEach(n=>stage.addEventListener(n,up));
const keys={ArrowUp:[0,-1],w:[0,-1],ArrowDown:[0,1],s:[0,1],ArrowLeft:[-1,0],a:[-1,0],ArrowRight:[1,0],d:[1,0]};

addEventListener('keydown',e=>{
  if(state==='menu'){if(e.key==='Escape'&&panel!=='main'){panel='main';render()}return}
  if(e.key===' '){e.preventDefault();state==='play'?pause():act()}
  else if(e.key==='p'||e.key==='Escape')pause();
  else if(e.key==='m'){sv.set.snd^=1;save();syncMute()}
  else if(keys[e.key]){e.preventDefault();if(state==='play')turn(...keys[e.key])}
});
$('menu').addEventListener('click',e=>{const el=e.target.closest('[data-a]');if(!el||el.disabled)return;try{act2(el.dataset.a)}catch(x){console.error('menu',x)}});
$('go').onclick=act;$('mn').onclick=quit;$('pz').onclick=pause;$('mu').onclick=()=>{sv.set.snd^=1;save();syncMute()};
document.addEventListener('visibilitychange',()=>{if(document.hidden)pause()});
addEventListener('blur',pause);addEventListener('pagehide',()=>{pause();save()});
window.ResizeObserver?new ResizeObserver(fit).observe(wrap):addEventListener('resize',fit);

$('pw').innerHTML=PU.map(()=>'<span hidden></span>').join('');
motes=Array.from({length:18},()=>({x:R(),y:R(),s:.6+R(),a:R()*6,v:.03+R()*.05}));
syncMute();reset();fit();daily();openMenu();requestAnimationFrame(frame);
window.__bloom=()=>({state,N,viewN,gold,clock,score,mD,snake,orbs,np:parts.length,sv,pw,boss,near,S,br,panel});
})();
</script>
